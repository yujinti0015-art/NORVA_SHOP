<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NØRVA — Clothing</title>

<style>
*{margin:0;padding:0;box-sizing:border-box}

html{scroll-behavior:smooth}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f5f5f3;
    color:#111;
}

/* ================= HEADER ================= */

header{
    width:100%;
    height:82px;
    background:#f5f5f3;
    border-bottom:1px solid #d8d8d5;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 55px;
    position:sticky;
    top:0;
    z-index:100;
}

/* NØRVA logo — O replaced with black hole */

.logo{
    display:flex;
    align-items:center;
    gap:3px;
    font-size:28px;
    font-weight:900;
    letter-spacing:5px;
}

.black-hole{
    position:relative;
    width:29px;
    height:29px;
    border-radius:50%;
    margin:0 2px;
    background:
        radial-gradient(
            circle,
            #000 0 35%,
            #111 36% 47%,
            #fff 48% 53%,
            #777 54% 60%,
            transparent 72%
        );
    box-shadow:
        0 0 5px rgba(0,0,0,.8),
        0 0 12px rgba(0,0,0,.25);
}

.black-hole::after{
    content:"";
    position:absolute;
    width:43px;
    height:5px;
    left:-7px;
    top:12px;
    border-radius:50%;
    background:linear-gradient(
        90deg,
        transparent,
        #777,
        #111,
        #777,
        transparent
    );
    transform:rotate(-8deg);
}

/* ================= NAV ================= */

nav{
    display:flex;
    align-items:center;
    gap:35px;
}

nav button{
    border:none;
    background:transparent;
    color:#111;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    text-transform:uppercase;
    letter-spacing:1px;
    transition:opacity .2s;
}

nav button:hover{
    opacity:.45;
}

.header-right{
    display:flex;
    gap:18px;
}

.icon-btn{
    width:38px;
    height:38px;
    border:1px solid #222;
    background:transparent;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    font-size:15px;
    transition:.2s;
}

.icon-btn:hover{
    background:#111;
    color:white;
}

/* ================= HERO ================= */

.hero{
    min-height:calc(100vh - 82px);
    display:grid;
    grid-template-columns:1fr 1fr;
    background:#111;
    color:white;
}

.hero-left{
    padding:80px 65px;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
}

.hero-small{
    font-size:12px;
    letter-spacing:3px;
    text-transform:uppercase;
    margin-bottom:20px;
    opacity:.65;
}

.hero h1{
    font-size:clamp(65px,9vw,150px);
    line-height:.82;
    letter-spacing:-7px;
    font-weight:900;
}

/* Большой логотип тоже с чёрной дырой вместо O */
.hero-logo{
    display:flex;
    align-items:center;
    gap:2px;
    font-size:clamp(65px,9vw,150px);
    line-height:.82;
    letter-spacing:-7px;
    font-weight:900;
}

.hero-logo .black-hole{
    width:clamp(62px,8vw,125px);
    height:clamp(62px,8vw,125px);
    margin:0 3px;
}

.hero-logo .black-hole::after{
    width:140%;
    left:-20%;
    top:47%;
    height:8px;
}

.hero-description{
    max-width:390px;
    margin-top:35px;
    font-size:14px;
    line-height:1.7;
    color:#aaa;
}

.hero-button{
    margin-top:35px;
    width:180px;
    height:50px;
    background:white;
    color:#111;
    border:none;
    font-size:12px;
    font-weight:bold;
    letter-spacing:2px;
    cursor:pointer;
    transition:.25s;
}

.hero-button:hover{
    background:#ccc;
}

.hero-image{
    min-height:650px;
    background:
        linear-gradient(rgba(0,0,0,.05),rgba(0,0,0,.35)),
        url("https://images.unsplash.com/photo-1523398002811-999ca8dec234?auto=format&fit=crop&w=1400&q=85");
    background-size:cover;
    background-position:center;
}

/* ================= CATEGORIES ================= */

.categories{
    padding:110px 55px 120px;
}

.section-top{
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    margin-bottom:45px;
}

.section-title{
    font-size:42px;
    letter-spacing:-2px;
    font-weight:800;
}

.section-number{
    font-size:11px;
    letter-spacing:2px;
    color:#777;
}

.category-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px;
}

.category{
    height:550px;
    position:relative;
    overflow:hidden;
    background:#ddd;
    cursor:pointer;
}

.category img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform .6s ease;
}

.category:hover img{
    transform:scale(1.04);
}

.category-overlay{
    position:absolute;
    inset:0;
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    padding:30px;
    background:linear-gradient(
        transparent 45%,
        rgba(0,0,0,.65)
    );
    color:white;
}

.category-name{
    font-size:35px;
    font-weight:800;
    letter-spacing:-1px;
}

.category-arrow{
    width:45px;
    height:45px;
    border:1px solid rgba(255,255,255,.7);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:20px;
}


/* ================= EMPTY CATEGORY VIEW ================= */

.category-view{
    display:none;
    min-height:calc(100vh - 82px);
    padding:65px 55px 110px;
    background:#f5f5f3;
}

.category-view.active{
    display:block;
}

.category-view-top{
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:30px;
    margin-bottom:45px;
    padding-bottom:22px;
    border-bottom:1px solid #d8d8d5;
}

.category-view-label{
    font-size:11px;
    color:#777;
    letter-spacing:3px;
    text-transform:uppercase;
    margin-bottom:14px;
}

.category-view-title{
    font-size:clamp(45px,7vw,100px);
    line-height:.9;
    font-weight:900;
    letter-spacing:-5px;
}

.back-button{
    border:1px solid #111;
    background:transparent;
    padding:14px 20px;
    font-size:11px;
    font-weight:700;
    letter-spacing:1px;
    cursor:pointer;
    white-space:nowrap;
}

.back-button:hover{
    background:#111;
    color:#fff;
}

.empty-category{
    min-height:420px;
    border:1px solid #d8d8d5;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    background:#efefed;
}

.empty-category p{
    font-size:15px;
    color:#777;
    letter-spacing:1px;
}


/* ================= PRODUCT IN HOODIES ================= */
.hoodie-products{margin:45px 0 0}
.hoodie-product{display:none;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:28px;background:#fff;border:1px solid #d8d8d5;cursor:pointer;overflow:hidden}
.hoodie-product.active{display:grid}
.hoodie-product-image{height:650px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:20px}
.hoodie-product-image img{width:100%;height:100%;object-fit:contain;background:#fff}
.hoodie-product-info{padding:48px 42px;display:flex;flex-direction:column;justify-content:center}
.hoodie-product-label,.product-detail-label{font-size:10px;letter-spacing:3px;color:#777;text-transform:uppercase;margin-bottom:18px}
.hoodie-product-name{font-size:42px;line-height:1;letter-spacing:-2px;font-weight:900;margin-bottom:22px}
.hoodie-product-description,.product-detail p{color:#666;font-size:14px;line-height:1.7;margin-bottom:30px}
.hoodie-product-meta,.product-data{border-top:1px solid #ddd;padding-top:22px;display:grid;gap:12px;font-size:13px}
.hoodie-product-meta div,.product-data-row{display:flex;justify-content:space-between;gap:20px}
.hoodie-product-price,.product-detail-price{font-size:28px;font-weight:800;margin-top:24px}
.hoodie-product-hint{margin-top:25px;font-size:10px;color:#999;letter-spacing:1px;text-transform:uppercase}

.product-modal{position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;justify-content:center;padding:30px;z-index:500}
.product-modal.active{display:flex}
.product-modal-inner{width:min(1180px,100%);max-height:92vh;overflow:auto;background:#f5f5f3;border:1px solid #333;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);position:relative}
.product-gallery{background:#fff;padding:18px}
.product-main-image{width:100%;aspect-ratio:1/1;object-fit:contain;background:#fff;display:block}
.product-thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}
.product-thumb{height:95px;width:100%;object-fit:cover;background:#fff;border:1px solid #ddd;cursor:pointer}
.product-thumb.active{border:2px solid #111}
.product-detail{padding:55px 42px;display:flex;flex-direction:column;justify-content:center}
.product-detail h3{font-size:43px;line-height:.95;letter-spacing:-2px;margin-bottom:22px}
.product-data{border-top:1px solid #ccc;border-bottom:1px solid #ccc;padding:18px 0}
.product-data-row strong{font-size:14px}
.product-close{position:absolute;right:16px;top:16px;width:38px;height:38px;border:1px solid #111;background:#fff;cursor:pointer;font-size:20px;z-index:3}
.product-close:hover{background:#111;color:#fff}
@media(max-width:900px){
.hoodie-product{grid-template-columns:1fr}
.hoodie-product-image{height:65vh;min-height:390px}
.hoodie-product-info{padding:35px 25px 40px}
.hoodie-product-name{font-size:34px}
.product-modal{padding:10px}
.product-modal-inner{max-height:96vh;grid-template-columns:1fr}
.product-gallery{padding:10px}
.product-detail{padding:28px 22px 35px}
.product-detail h3{font-size:34px}
.product-thumb{height:80px}
}

/* ================= MOBILE ================= */

@media(max-width:900px){

    header{
        height:70px;
        padding:0 18px;
    }

    nav{
        display:none;
    }

    .header-right{
        gap:7px;
    }

    .icon-btn{
        width:34px;
        height:34px;
    }

    .hero{
        grid-template-columns:1fr;
        min-height:0;
    }

    .hero-left{
        min-height:470px;
        padding:40px 22px 45px;
    }

    .hero-image{
        min-height:62vh;
        height:62vh;
    }

    .categories{
        padding:65px 18px 80px;
    }

    .category-grid{
        grid-template-columns:1fr;
        gap:14px;
    }

    .category{
        height:70vh;
        min-height:420px;
        max-height:620px;
    }

    .category-name{
        font-size:32px;
    }

    .category-overlay{
        padding:24px;
    }
}

@media(max-width:550px){

    body{
        overflow-x:hidden;
    }

    .logo{
        font-size:21px;
        letter-spacing:3px;
    }

    .logo .black-hole{
        width:22px;
        height:22px;
        margin:0 1px;
    }

    .logo .black-hole::after{
        width:34px;
        left:-6px;
        top:9px;
        height:4px;
    }

    .header-right{
        gap:5px;
    }

    .icon-btn{
        width:31px;
        height:31px;
        font-size:13px;
    }

    .hero-left{
        min-height:430px;
        padding:34px 20px 38px;
    }

    .hero-small{
        font-size:10px;
        letter-spacing:2px;
        margin-bottom:18px;
    }

    .hero-logo{
        font-size:58px;
        letter-spacing:-4px;
    }

    .hero-logo .black-hole{
        width:48px;
        height:48px;
        margin:0 2px;
    }

    .hero-logo .black-hole::after{
        height:5px;
    }

    .hero-description{
        max-width:100%;
        margin-top:28px;
        font-size:13px;
        line-height:1.65;
    }

    .hero-image{
        min-height:58vh;
        height:58vh;
    }

    .section-top{
        margin-bottom:25px;
    }

    .category-view{
        padding:45px 20px 75px;
        min-height:calc(100vh - 70px);
    }

    .category-view-top{
        margin-bottom:35px;
        align-items:flex-start;
        padding-bottom:18px;
    }

    .category-view-title{
        font-size:50px;
        letter-spacing:-3px;
    }

    .category-view-label{
        font-size:9px;
        letter-spacing:2px;
        margin-bottom:11px;
    }

    .empty-category{
        min-height:300px;
    }

    .empty-category p{
        max-width:260px;
        font-size:15px;
        line-height:1.6;
    }

    .section-title{
        font-size:30px;
        letter-spacing:-1px;
    }

    .section-number{
        font-size:9px;
    }

    .category{
        height:68vh;
        min-height:390px;
    }

    .category-name{
        font-size:29px;
        letter-spacing:1px;
    }

    .category-arrow{
        width:42px;
        height:42px;
    }
}

@media(min-width:901px){

    .category-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .category{
        min-width:0;
    }
}
</style>
</head>

<body>

<!-- ================= HEADER ================= -->

<header>

    <div class="logo">
        <span>N</span>
        <span class="black-hole"></span>
        <span>RVA</span>
    </div>

    <nav>
        <button>Новинки</button>
    </nav>

    <div class="header-right">
        <button class="icon-btn">⌕</button>
        <button class="icon-btn">♡</button>
        <button class="icon-btn">▢</button>
    </div>

</header>

<!-- ================= HERO ================= -->

<section class="hero">

    <div class="hero-left">

        <div class="hero-small">
            New collection / 2026
        </div>

        <div class="hero-logo">
            <span>N</span>
            <span class="black-hole"></span>
            <span>RVA</span>
        </div>

        <p class="hero-description">
            Чоловічий одяг
        </p>

    </div>

    <div class="hero-image"></div>

</section>

<!-- ================= ONLY CATEGORIES ================= -->

<section class="categories">

    <div class="section-top">

        <h2 class="section-title">
            Категорії
        </h2>

        <span class="section-number">
            02 / 02
        </span>

    </div>

    <div class="category-grid">

        <div class="category" data-category="СУМКИ">
            <img src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=1200&q=85" alt="Сумки">
            <div class="category-overlay">
                <div class="category-name">СУМКИ</div>
                <div class="category-arrow">→</div>
            </div>
        </div>

        <div class="category">
            <img src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=1200&q=85" alt="Кофти">
            <div class="category-overlay">
                <div class="category-name">КОФТИ</div>
                <div class="category-arrow">→</div>
            </div>
        </div>

        <div class="category">
            <img src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?auto=format&fit=crop&w=1200&q=85" alt="Штани">
            <div class="category-overlay">
                <div class="category-name">ШТАНИ</div>
                <div class="category-arrow">→</div>
            </div>
        </div>

        <div class="category">
            <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=1200&q=85" alt="Футболки">
            <div class="category-overlay">
                <div class="category-name">ФУТБОЛКИ</div>
                <div class="category-arrow">→</div>
            </div>
        </div>

        <div class="category">
            <img src="https://images.unsplash.com/photo-1544022613-e87ca75a784a?auto=format&fit=crop&w=1200&q=85" alt="Куртки">
            <div class="category-overlay">
                <div class="category-name">КУРТКИ</div>
                <div class="category-arrow">→</div>
            </div>
        </div>

        <div class="category">
            <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1200&q=85" alt="Взуття">
            <div class="category-overlay">
                <div class="category-name">ВЗУТТЯ</div>
                <div class="category-arrow">→</div>
            </div>
        </div>

    </div>


</section>

<section class="hoodie-products" id="hoodieProducts">
    <div class="hoodie-product" id="hoodieProduct">
        <div class="hoodie-product-image">
            <img src="data:image/jpeg;base64," alt="NØRVA ZIP HOODIE">
        </div>
        <div class="hoodie-product-info">
            <div class="hoodie-product-label">ТОВАР / КОФТИ</div>
            <div class="hoodie-product-name">NØRVA ZIP HOODIE</div>
            <div class="hoodie-product-description">
                Чоловіча кофта на блискавці з капюшоном, декоративними написами
                та контрастними білими смугами на рукавах.
            </div>
            <div class="hoodie-product-meta">
                <div><span>Розмір</span><strong>160</strong></div>
                <div><span>Стан</span><strong>В наявності</strong></div>
            </div>
            <div class="hoodie-product-price">899 ₴</div>
            <div class="hoodie-product-hint">Натисніть, щоб переглянути всі фото</div>
        </div>
    </div>
</section>

<section class="category-view" id="categoryView">
    <div class="category-view-top">
        <div>
            <div class="category-view-label">РОЗДІЛ</div>
            <h2 class="category-view-title" id="categoryViewTitle">СУМКИ</h2>
        </div>
        <button class="back-button" id="backButton">← НАЗАД</button>
    </div>

    <div class="empty-category">
        <p>У цьому розділі поки що немає товарів.</p>
    </div>
</section>

<div class="product-modal" id="productModal">
    <div class="product-modal-inner">
        <button class="product-close" id="productClose">×</button>
        <div class="product-gallery">
            <img class="product-main-image" id="productMainImage" src="data:image/jpeg;base64," alt="NØRVA ZIP HOODIE">
            <div class="product-thumbs">
                <img class="product-thumb active" src="data:image/jpeg;base64," data-image="data:image/jpeg;base64," alt="Фото 1">
                <img class="product-thumb" src="data:image/jpeg;base64," data-image="data:image/jpeg;base64," alt="Фото 2">
                <img class="product-thumb" src="data:image/jpeg;base64," data-image="data:image/jpeg;base64," alt="Фото 3">
                <img class="product-thumb" src="data:image/jpeg;base64," data-image="data:image/jpeg;base64," alt="Фото 4">
            </div>
        </div>
        <div class="product-detail">
            <div class="product-detail-label">NØRVA / КОФТИ</div>
            <h3>NØRVA ZIP HOODIE</h3>
            <p>Чоловіча кофта на блискавці з капюшоном. Модель має контрастні вставки на рукавах та декоративний принт.</p>
            <div class="product-data">
                <div class="product-data-row"><span>Розмір</span><strong>160</strong></div>
                <div class="product-data-row"><span>Ціна</span><strong>899 ₴</strong></div>
            </div>
            <div class="product-detail-price">899 ₴</div>
        </div>
    </div>
</div>

<script>
const categoryCards = document.querySelectorAll('.category');
const categoriesSection = document.querySelector('.categories');
const categoryView = document.getElementById('categoryView');
const categoryViewTitle = document.getElementById('categoryViewTitle');
const backButton = document.getElementById('backButton');
const hoodieProduct = document.getElementById('hoodieProduct');
const productModal = document.getElementById('productModal');
const productClose = document.getElementById('productClose');
const productMainImage = document.getElementById('productMainImage');
const productThumbs = document.querySelectorAll('.product-thumb');

categoryCards.forEach(card => {
    card.addEventListener('click', () => {
        const titleElement = card.querySelector('.category-name');
        const categoryName = card.dataset.category || (titleElement ? titleElement.textContent.trim() : 'РОЗДІЛ');

        categoryViewTitle.textContent = categoryName;
        categoriesSection.style.display = 'none';
        categoryView.classList.add('active');
        hoodieProduct.classList.toggle('active', categoryName === 'КОФТИ');
        window.scrollTo({top: 0, behavior: 'smooth'});
    });
});

backButton.addEventListener('click', () => {
    categoryView.classList.remove('active');
    hoodieProduct.classList.remove('active');
    categoriesSection.style.display = '';
    window.scrollTo({top: 0, behavior: 'smooth'});
});

hoodieProduct.addEventListener('click', () => {
    productModal.classList.add('active');
    document.body.style.overflow = 'hidden';
});

function closeProductModal(){
    productModal.classList.remove('active');
    document.body.style.overflow = '';
}

productClose.addEventListener('click', closeProductModal);

productModal.addEventListener('click', event => {
    if(event.target === productModal) closeProductModal();
});

productThumbs.forEach(thumb => {
    thumb.addEventListener('click', event => {
        event.stopPropagation();
        productMainImage.src = thumb.dataset.image;
        productThumbs.forEach(item => item.classList.remove('active'));
        thumb.classList.add('active');
    });
});
</script>

</body>
</html>
